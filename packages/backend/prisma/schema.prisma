generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  userName  String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]

  lecturerId String?
  lecturer   User?   @relation("LecturerStudent", fields: [lecturerId], references: [id])
  students   User[]  @relation("LecturerStudent")

  approvedReservations Reservation[] @relation("LecturerApprovals")

  history       UserHistory[]
  borrowHistory BorrowHistory[]
}

model DeviceCategory {
  id       String   @id @default(uuid())
  name     String   @unique
  quantity Int      @default(0) // Số lượng thiết bị theo loại
  devices  Device[]
}

model Device {
  id           String         @id @default(uuid())
  deviceName   String
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  status       DeviceStatus   @default(NOT_IN_USE)
  borrowStatus BorrowStatus   @default(COMPLETED)
  categoryId   String
  category     DeviceCategory @relation(fields: [categoryId], references: [id])

  reservations  Reservation[]
  borrowHistory BorrowHistory[]
}

model Lab {
  id           String        @id @default(uuid())
  labName      String        @default("LabRoom")
  status       LabStatus
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
}

model Reservation {
  id        String            @id @default(uuid())
  userId    String
  deviceId  String?
  labId     String?
  startTime DateTime
  endTime   DateTime
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  lecturerId    String? // Giảng viên xét duyệt
  adminApproved Boolean? @default(false) // Admin duyệt lần cuối

  user     User    @relation(fields: [userId], references: [id])
  device   Device? @relation(fields: [deviceId], references: [id])
  lab      Lab?    @relation(fields: [labId], references: [id])
  lecturer User?   @relation(fields: [lecturerId], references: [id], name: "LecturerApprovals")

  borrowHistory BorrowHistory?
  history       UserHistory[]
}

model BorrowHistory {
  id              String    @id @default(uuid())
  reservationId   String    @unique
  userId          String
  deviceId        String
  borrowTime      DateTime
  returnTime      DateTime?
  deviceCondition String?
  createdAt       DateTime  @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  device      Device      @relation(fields: [deviceId], references: [id])
}

model UserHistory {
  id            String   @id @default(uuid())
  userId        String
  reservationId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

enum DeviceStatus {
  IN_USE
  NOT_IN_USE
  DAMAGED
  DISPOSING
}

enum BorrowStatus {
  PENDING_BORROW
  BORROWED
  COMPLETED
}

enum LabStatus {
  AVAILABLE
  IN_USE
  UNDER_MAINTENANCE
}

enum ReservationStatus {
  PENDING
  APPROVED_BY_LECTURER
  APPROVED
  REJECTED
}

model Login {
  id               Int     @id @default(autoincrement()) @map("id")
  email            String  @map("email") @db.VarChar(40)
  password         String  @map("password")
  mail             String? @map("mail") @db.VarChar(250)
  mail_alert1_flag Boolean @default(false) @map("mail_alert1_flag")
  mail_alert2_flag Boolean @default(false) @map("mail_alert2_flag")
}
