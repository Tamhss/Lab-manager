generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId    String   @id @default(uuid())
  userName  String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student?  @relation("UserStudent")
  lecturer  Lecturer? @relation("UserLecturer")
  admin     Admin?    @relation("UserAdmin")

  reservations Reservation[]
  history      UserHistory[]
  borrowHistory BorrowHistory[]
}

model Student {
  studentId String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation("UserStudent", fields: [userId], references: [userId])

  lecturerId String?
  lecturer   Lecturer? @relation("LecturerStudent", fields: [lecturerId], references: [lecturerId])
}

model Lecturer {
  lecturerId String  @id @default(uuid())
  userId     String  @unique
  user       User    @relation("UserLecturer", fields: [userId], references: [userId])

  students   Student[] @relation("LecturerStudent")
  approvedReservations Reservation[] @relation("LecturerApprovals")
}

model Admin {
  adminId String  @id @default(uuid())
  userId  String  @unique
  user    User    @relation("UserAdmin", fields: [userId], references: [userId])
}

model DeviceCategory {
  categoryId String   @id @default(uuid())
  name       String   @unique
  quantity   Int      @default(0)
  devices    Device[]
}

model Device {
  deviceId     String         @id
  deviceName   String
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  status       DeviceStatus   @default(NOT_IN_USE)
  borrowStatus BorrowStatus   @default(COMPLETED)
  categoryId   String
  category     DeviceCategory @relation(fields: [categoryId], references: [categoryId])

  reservations  Reservation[]
  borrowHistory BorrowHistory[]
}

model Lab {
  labId     String        @id @default(uuid())
  labName   String        @default("LabRoom")
  status    LabStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  reservations Reservation[]
}

model Reservation {
  reservationId String            @id @default(uuid())
  userId        String
  deviceId      String?
  labId         String?
  startTime     DateTime
  endTime       DateTime
  status        ReservationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  actualBorrowTime DateTime? // Thêm trường này
  actualReturnTime DateTime?
  lecturerId    String?
  adminApproved Boolean? @default(false)

  user     User      @relation(fields: [userId], references: [userId])
  device   Device?   @relation(fields: [deviceId], references: [deviceId])
  lab      Lab?      @relation(fields: [labId], references: [labId])
  lecturer Lecturer? @relation("LecturerApprovals", fields: [lecturerId], references: [lecturerId])

  borrowHistory BorrowHistory?
  history       UserHistory[]
}
model BorrowHistory {
  borrowHistoryId String    @id @default(uuid())
  reservationId   String    @unique
  userId          String
  deviceId        String
  actualBorrowTime      DateTime
  actualReturnTime      DateTime?
  deviceCondition String?
  createdAt       DateTime  @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [reservationId])
  user        User        @relation(fields: [userId], references: [userId])
  device      Device      @relation(fields: [deviceId], references: [deviceId])
}
model UserHistory {
  userHistoryId String   @id @default(uuid())
  userId        String
  reservationId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [userId])
  reservation Reservation @relation(fields: [reservationId], references: [reservationId])
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

enum DeviceStatus {
  IN_USE
  NOT_IN_USE
  DAMAGED
  DISPOSING
}

enum BorrowStatus {
  PENDING_BORROW
  BORROWED
  COMPLETED
}

enum LabStatus {
  AVAILABLE
  IN_USE
  UNDER_MAINTENANCE
}

enum ReservationStatus {
  PENDING
  APPROVED_BY_LECTURER
  APPROVED
  REJECTED
  COMPLETED
}

model Login {
  id               Int     @id @default(autoincrement()) @map("id")
  email            String  @map("email") @db.VarChar(40)
  password         String  @map("password")
  mail             String? @map("mail") @db.VarChar(250)
  mail_alert1_flag Boolean @default(false) @map("mail_alert1_flag")
  mail_alert2_flag Boolean @default(false) @map("mail_alert2_flag")
}
