generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId    String   @id @default(uuid())
  userName  String
  code      String   @unique
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  Student?  @relation("UserStudent")
  lecturer Lecturer? @relation("UserLecturer")
  admin    Admin?    @relation("UserAdmin")

  reservationsDevice  ReservationDevice[]
  reservationsLab     ReservationLab[]
  history             UserHistory[]
  deviceBorrowHistory DeviceBorrowHistory[]
  labBorrowHistory    LabBorrowHistory[]
}

model Student {
  studentId String @id @default(uuid())
  userId    String @unique
  user      User   @relation("UserStudent", fields: [userId], references: [userId])

  lecturerId String?
  lecturer   Lecturer? @relation("LecturerStudent", fields: [lecturerId], references: [lecturerId])
}

model Lecturer {
  lecturerId String @id @default(uuid())
  userId     String @unique
  user       User   @relation("UserLecturer", fields: [userId], references: [userId])

  students                   Student[]           @relation("LecturerStudent")
  approvedDeviceReservations ReservationDevice[] @relation("LecturerApprovals")
  approvedLabReservations    ReservationLab[]    @relation("LecturerApprovals")
}

model Admin {
  adminId String @id @default(uuid())
  userId  String @unique
  user    User   @relation("UserAdmin", fields: [userId], references: [userId])
}

model DeviceCategory {
  categoryId String   @id @default(uuid())
  name       String
  quantity   Int      @default(0)
  labId      String
  lab        Lab      @relation(fields: [labId], references: [labId])
  devices    Device[]
}

model Device {
  deviceId     String         @id
  deviceName   String
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  status       DeviceStatus   @default(NOT_IN_USE)
  borrowStatus BorrowStatus   @default(COMPLETED)
  categoryId   String
  category     DeviceCategory @relation(fields: [categoryId], references: [categoryId])

  reservations  ReservationDevice[]
  borrowHistory DeviceBorrowHistory[]
}

model Lab {
  labId        String       @id @default(uuid())
  labName      String       @default("LabRoom")
  status       LabStatus
  borrowStatus BorrowStatus @default(COMPLETED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  deviceCategories DeviceCategory[]
  reservations     ReservationLab[]
  borrowHistory    LabBorrowHistory[]
  reservationDevices ReservationDevice[]
}

model ReservationDevice {
  deviceReservationId String            @id @default(uuid())
  userId              String
  labId               String?
  deviceId            String?
  startTime           DateTime
  endTime             DateTime
  status              ReservationStatus @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  actualBorrowTime    DateTime?
  actualReturnTime    DateTime?
  lecturerId          String?
  adminApproved       Boolean?          @default(false)

  user     User      @relation(fields: [userId], references: [userId])
  lab      Lab?      @relation(fields: [labId], references: [labId])
  device   Device?   @relation(fields: [deviceId], references: [deviceId])
  lecturer Lecturer? @relation("LecturerApprovals", fields: [lecturerId], references: [lecturerId])

  borrowHistory DeviceBorrowHistory?
  history       UserHistory[]
}

model ReservationLab {
  labReservationId String            @id @default(uuid())
  userId           String
  labId            String?
  startTime        DateTime
  endTime          DateTime
  status           ReservationStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  actualBorrowTime DateTime?
  actualReturnTime DateTime?
  lecturerId       String?
  adminApproved    Boolean?          @default(false)

  user     User      @relation(fields: [userId], references: [userId])
  lab      Lab?      @relation(fields: [labId], references: [labId])
  lecturer Lecturer? @relation("LecturerApprovals", fields: [lecturerId], references: [lecturerId])

  borrowHistory LabBorrowHistory?
}

model DeviceBorrowHistory {
  borrowHistoryId     String    @id @default(uuid())
  deviceReservationId String    @unique
  userId              String
  deviceId            String
  actualBorrowTime    DateTime
  actualReturnTime    DateTime?
  deviceCondition     String?
  createdAt           DateTime  @default(now())

  reservation ReservationDevice @relation(fields: [deviceReservationId], references: [deviceReservationId])
  user        User              @relation(fields: [userId], references: [userId])
  device      Device            @relation(fields: [deviceId], references: [deviceId])
}

model LabBorrowHistory {
  borrowHistoryId  String    @id @default(uuid())
  labReservationId String    @unique
  userId           String
  labId            String
  actualBorrowTime DateTime
  actualReturnTime DateTime?
  labCondition     String?
  createdAt        DateTime  @default(now())

  reservation ReservationLab @relation(fields: [labReservationId], references: [labReservationId])
  user        User           @relation(fields: [userId], references: [userId])
  lab         Lab            @relation(fields: [labId], references: [labId])
}

model UserHistory {
  userHistoryId       String   @id @default(uuid())
  userId              String
  deviceReservationId String
  createdAt           DateTime @default(now())

  user              User              @relation(fields: [userId], references: [userId])
  reservationDevice ReservationDevice @relation(fields: [deviceReservationId], references: [deviceReservationId])
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

enum DeviceStatus {
  IN_USE
  NOT_IN_USE
  DAMAGED
  DISPOSING
}

enum BorrowStatus {
  PENDING_BORROW
  BORROWED
  COMPLETED
}

enum LabStatus {
  AVAILABLE
  IN_USE
  UNDER_MAINTENANCE
}

enum ReservationStatus {
  PENDING
  APPROVED_BY_LECTURER
  APPROVED
  REJECTED
  COMPLETED
}
